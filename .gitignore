# TTS 音声キャッシュ（実行時に再生成される）
static/audio/*.mp3
static/audio/*.wav
!static/audio/.gitkeep
!static/audio/conjugate/
!static/audio/conjugate/*.mp3

# Debate app: 録音データ（ユーザーの音声。data/debate/*.json は上の *.json ルールで除外済み）
data/debate/audio/*

# Level Check app: 録音データ・セッションデータ（data/level_check/*.json は上の *.json ルールで除外済み）
data/level_check/audio/*
data/level_check/sessions/*

# Vibe Speak Conjugate: 一時音声・セッションデータ（data/conjugate/*.json は上の *.json ルールで除外済み）
data/conjugate/audio_tmp/*
data/conjugate/sessions/*

# Vibe Speak Trigger: 録音データ・セッションデータ（data/trigger/*.json は上の *.json ルールで除外済み）
data/trigger/audio/*
data/trigger/sessions/*

# Toolbox: 一時音声・理解確認セッション（data/toolbox/*.json は上の *.json ルールで除外済み）
data/toolbox/audio_tmp/*
data/toolbox/talk_sessions/*
