# ローカル開発用。本番（Render など）ではダッシュボードの Environment に設定する
OPENAI_API_KEY=sk-your-key-here

# 任意: 日替わりクラスコードのトークン署名用（未設定時は OPENAI_API_KEY を利用）
# GATE_SECRET=your-random-secret

# 任意: クラスコードロック（true/false）。Render では render.yaml で false 推奨
# GATE_LOCK_ENABLED=false

# 任意: Flask セッション用（本番では必ずランダムな値を設定）
# FLASK_SECRET_KEY=your-random-secret

# 必須: 管理画面パスワード。未設定だと管理操作は 503 で拒否される
ADMIN_PASSWORD=change-me

# 任意: アプリ単位の上書き（設定時は ADMIN_PASSWORD より優先）
# GTEC_ADMIN_PASSWORD=
# TRIGGER_ADMIN_PASSWORD=
# CONJUGATE_ADMIN_PASSWORD=
# LEVEL_CHECK_ADMIN_PASSWORD=
# DEBATE_ADMIN_PASSWORD=
# TOOLBOX_ADMIN_PASSWORD=

# 必須: debate 観戦プレビュートークンの署名鍵（未設定だとプレビュー発行不可）
DEBATE_PREVIEW_SECRET=change-me
